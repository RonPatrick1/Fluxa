# Operating-system and editor state
.DS_Store
.idea/
*.iml
*.swp
/.aider.tags.cache.v4/

# Native build output
/hello_ron
*.o
*.so
*.dylib

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
/node_modules/
/test-results/
/playwright-report/

# Fluxa runtime state. Media files are never stored here.
/.fluxa/
/fluxa.json

# Flutter and Dart generated output
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/build/
**/coverage/

# Android machine state and signing material
**/.gradle/
**/.kotlin/
**/local.properties
**/key.properties
**/*.keystore
**/*.jks
**/*.p12
**/*.pfx

# Samsung/Tizen generated packages and IDE state
**/.buildResult/
/workspace/

# Xcode, CocoaPods, and Flutter iOS generated output
**/DerivedData/
**/Pods/
**/.symlinks/
**/xcuserdata/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
